# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Required when DJANGO_DEBUG is off. Any long random string.
DJANGO_SECRET_KEY=
# 1 for local development, 0 (or empty) for anything public.
DJANGO_DEBUG=1
# Comma separated host names the app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite file. Empty means db.sqlite3 in the repository root.
DATABASE_PATH=

# AI provider for generated texts: mock (default, offline, labelled as mock).
AI_PROVIDER=mock
# The Groq adapter arrives in a later change. Its key will be set here, never in the code:
# GROQ_API_KEY=
