# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Required when DJANGO_DEBUG is off. Any long random string.
DJANGO_SECRET_KEY=
# 1 for local development, 0 (or empty) for anything public.
DJANGO_DEBUG=1
# Comma separated host names the app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite file. Empty means db.sqlite3 in the repository root.
DATABASE_PATH=

# AI provider for generated texts: mock (default, offline, labelled as mock) or groq.
AI_PROVIDER=mock
# Required when AI_PROVIDER=groq. A free key from the Groq console; never commit it.
GROQ_API_KEY=
# Model used by the groq provider. Empty means qwen/qwen3.8-27b. Groq retires models from time to
# time; the Groq console lists the current ones (openai/gpt-oss-120b also writes good Polish).
GROQ_MODEL=
# Source of cited passages for AI texts. "none" is the only value until retrieval exists.
KNOWLEDGE_SOURCE=none

# How e-mail leaves the application: console (default, prints to the terminal) or smtp.
EMAIL_MODE=console
# Used when EMAIL_MODE=smtp. For Gmail: smtp.gmail.com, port 587, your address and an app password
# (a Google account with 2-step verification can create one). EMAIL_PASS is never your real password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# The sender shown to people. Empty means EMAIL_USER.
EMAIL_FROM=
# Links in e-mails (activation, password reset, invitations) start with this address.
APP_BASE_URL=http://localhost:8000/
# 1 lets the old register operation create an active account without e-mail confirmation.
# Empty means on while DJANGO_DEBUG is on and off otherwise.
ALLOW_LEGACY_REGISTER=
